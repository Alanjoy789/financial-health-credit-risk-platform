-- Create a dedicated Measures table, then add these measures.
Total Customers = DISTINCTCOUNT('Dim Customer'[customer_id])
Total Exposure = SUM('Customer Risk Profile'[outstanding_balance])
High Risk Customers = CALCULATE([Total Customers], 'Customer Risk Profile'[risk_band] IN {"High","Critical"})
High Risk Rate = DIVIDE([High Risk Customers], [Total Customers])
Exposure 30+ DPD = CALCULATE([Total Exposure], 'Customer Risk Profile'[days_past_due] >= 30)
Exposure 30+ DPD % = DIVIDE([Exposure 30+ DPD], [Total Exposure])
Average Risk Score = AVERAGE('Customer Risk Profile'[risk_score])
Top 5% Exposure = CALCULATE([Total Exposure], 'Customer Risk Profile'[top_5pct_flag] = 1)
Vulnerable High Risk Customers = CALCULATE([Total Customers], 'Dim Customer'[vulnerability_flag] = 1, 'Customer Risk Profile'[risk_band] IN {"High","Critical"})
Net Cashflow = SUM('Fact Transaction'[amount])
Inflows = CALCULATE([Net Cashflow], 'Fact Transaction'[amount] > 0)
Outflows = -CALCULATE([Net Cashflow], 'Fact Transaction'[amount] < 0)
Savings Rate = DIVIDE([Inflows]-[Outflows],[Inflows])
Rolling 3M Net Cashflow = CALCULATE([Net Cashflow], DATESINPERIOD('Dim Date'[Date], MAX('Dim Date'[Date]), -3, MONTH))
Customers Improving = COUNTROWS(FILTER(VALUES('Dim Customer'[customer_id]), [Rolling 3M Net Cashflow] > 0))
Reconciliation Failures = CALCULATE(COUNTROWS('Balance Reconciliation'), 'Balance Reconciliation'[status] = "FAIL")
Model Status = IF([Reconciliation Failures]=0,"PASS","REVIEW")
